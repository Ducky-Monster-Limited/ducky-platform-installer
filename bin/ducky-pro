#!/usr/bin/env node
// ducky-pro — the local install's command (plan_0011 §4).
//
//   ducky-pro install [--path <dir>] [--dry-run] [--yes] [--no-sudo]
//                 [--skip a,b] [--only a,b]
//   ducky-pro start [--no-open]     ducky-pro stop [--force]     ducky-pro status
//   ducky-pro update [--check] [--release <v>] [--main] [--dry-run]
//   ducky-pro health                ducky-pro link
//   ducky-pro logs [api|app|local|sidequest|nginx] [-f]
//
// The install root: --path <dir> (or --root), else DUCKY_HOME; install
// then takes the current folder, every other command the nearest folder
// up holding config/ducky.json, else the last install.

let brand    = require('../lib/brand')
let commands = require('../lib/commands')

// ---

let verbs = ['health', 'install', 'link', 'logs', 'start', 'status', 'stop', 'update']

/**
 * The run.
 *
 * @returns {Promise<number>} Exit code
 */
async function run() {

    let argv = process.argv.slice(2)
    let verb = argv[0]
    let ctx  = null

    // the cli's way: bare = logo + help, --help = help, --version
    if (!verb) {
        brand.showLogo()
        brand.showHelp()
        return 0
    }
    if (verb === '--help' || verb === '-h' || verb === 'help') {
        brand.showHelp()
        return 0
    }
    if (verb === '--version' || verb === '-v') {
        console.log('ducky-pro ' + brand.getVersion())
        return 0
    }
    if (verbs.indexOf(verb) === -1) {
        brand.showHelp()
        return 2
    }

    if (verb === 'install' && process.stdout.isTTY) brand.showLogo()

    ctx = commands.getContext(argv.slice(1), verb)

    if (verb === 'logs') return commands.logs(ctx, argv[1] && !/^-/.test(argv[1]) ? argv[1] : 'api')

    return commands[verb](ctx)

}

// ---

run().then(function(code) {

    process.exitCode = code

}).catch(function(err) {

    console.log('[err]  ' + err.message)
    process.exitCode = 1

})
